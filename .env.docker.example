# Copy to .env in the repository root, then set secure secrets.
MONGO_DATABASE=webdl
API_PORT=5000
CLIENT_PORT=3100
ADMIN_PORT=3101
API_PREFIX=/api
CLIENT_ORIGIN=http://localhost:3100
ADMIN_ORIGIN=http://localhost:3101
PUBLIC_SITE_URL=http://localhost:3100
EXTRA_CORS_ORIGINS=
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
ADMIN_SETUP_KEY=replace_with_a_private_setup_key
ASSET_BASE_URL=
